{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "browser",
  "description": "Restricted browser/web-preview capabilities without filesystem, shell, process, SQL, or updater access.",
  "windows": ["browser-*", "browser-main", "preview-web-*"],
  "webviews": ["browser-*", "browser-main", "tab-*", "preview-web-*"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:event:allow-listen",
    "core:event:allow-emit",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-is-maximized",
    "core:window:allow-toggle-maximize",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-is-visible",
    "core:window:allow-set-focus",
    "core:window:allow-set-title",
    "core:webview:allow-create-webview-window",
    "core:webview:allow-create-webview",
    "core:webview:allow-webview-close",
    "core:webview:allow-set-webview-position",
    "core:webview:allow-set-webview-size",
    "core:webview:allow-set-webview-focus",
    "core:webview:allow-webview-show",
    "core:webview:allow-webview-hide",
    "core:webview:allow-reparent",
    "opener:default",
    "opener:allow-open-url",
    "log:default",
    "log:allow-log",
    "os:default",
    "os:allow-os-type",
    "os:allow-arch",
    "os:allow-platform",
    "os:allow-version",
    "os:allow-locale",
    "store:default",
    "store:allow-get",
    "store:allow-set",
    "store:allow-delete",
    "store:allow-clear",
    "store:allow-save",
    "store:allow-load"
  ]
}
