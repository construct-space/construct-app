{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for Construct",
  "windows": ["main", "main-*", "standalone-assistant", "construct-window-*", "oauth-login", "runner-*", "preview-*", "editor-standalone-*", "detach-space-*", "detach-assistant-*"],
  "webviews": ["main", "main-*", "construct-window-*", "runner-*", "preview-*", "editor-standalone-*", "detach-space-*", "detach-assistant-*"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:event:allow-listen",
    "core:event:allow-emit",
    "shell:allow-open",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        { "name": "curl", "cmd": "curl", "args": true, "sidecar": false },
        { "name": "tar", "cmd": "tar", "args": true, "sidecar": false },
        { "name": "bun", "cmd": "bun", "args": true, "sidecar": false },
        { "name": "npm", "cmd": "npm", "args": true, "sidecar": false },
        { "name": "yarn", "cmd": "yarn", "args": true, "sidecar": false },
        { "name": "pnpm", "cmd": "pnpm", "args": true, "sidecar": false },
        { "name": "go", "cmd": "go", "args": true, "sidecar": false },
        { "name": "python3", "cmd": "python3", "args": true, "sidecar": false },
        { "name": "cargo", "cmd": "cargo", "args": true, "sidecar": false }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        { "name": "curl", "cmd": "curl", "args": true, "sidecar": false },
        { "name": "tar", "cmd": "tar", "args": true, "sidecar": false },
        { "name": "bun", "cmd": "bun", "args": true, "sidecar": false },
        { "name": "npm", "cmd": "npm", "args": true, "sidecar": false },
        { "name": "yarn", "cmd": "yarn", "args": true, "sidecar": false },
        { "name": "pnpm", "cmd": "pnpm", "args": true, "sidecar": false },
        { "name": "go", "cmd": "go", "args": true, "sidecar": false },
        { "name": "python3", "cmd": "python3", "args": true, "sidecar": false },
        { "name": "cargo", "cmd": "cargo", "args": true, "sidecar": false }
      ]
    },
    "shell:allow-kill",
    "shell:allow-stdin-write",
    "fs:default",
    "fs:allow-read-dir",
    "fs:allow-read-file",
    "fs:allow-read-text-file",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    "fs:allow-exists",
    "fs:allow-stat",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-copy-file",
    "fs:allow-watch",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$APPDATA/**" },
        { "path": "$APPDATA/Construct" },
        { "path": "$APPDATA/Construct/**" },
        { "path": "$HOME/Library/Application Support/Construct" },
        { "path": "$HOME/Library/Application Support/Construct/**" },
        { "path": "$HOME/.local/share/construct" },
        { "path": "$HOME/.local/share/construct/**" },
        { "path": "$HOME/AppData/Roaming/Construct" },
        { "path": "$HOME/AppData/Roaming/Construct/**" },
        { "path": "$HOME/ConstructProjects" },
        { "path": "$HOME/ConstructProjects/**" },
        { "path": "$HOME/ConstructProjects/**/.*" },
        { "path": "$HOME/ConstructProjects/**/.*/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DOCUMENT/**/.*" },
        { "path": "$DOCUMENT/**/.*/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$DESKTOP/**/.*" },
        { "path": "$DESKTOP/**/.*/**" },
        { "path": "$DOWNLOAD" },
        { "path": "$DOWNLOAD/**" },
        { "path": "/tmp/**" }
      ]
    },
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "dialog:allow-confirm",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-is-maximized",
    "core:window:allow-toggle-maximize",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-is-visible",
    "core:window:allow-set-focus",
    "core:window:allow-set-title",
    "updater:default",
    "updater:allow-check",
    "updater:allow-download-and-install",
    "process:allow-restart",
    "process:allow-exit",
    "opener:default",
    "opener:allow-open-url",
    "deep-link:default",
    "sql:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-close",
    "core:webview:allow-create-webview-window",
    "core:webview:allow-create-webview",
    "core:webview:allow-webview-close",
    "core:webview:allow-set-webview-position",
    "core:webview:allow-set-webview-size",
    "core:webview:allow-set-webview-focus",
    "core:webview:allow-webview-show",
    "core:webview:allow-webview-hide",
    "core:webview:allow-reparent",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "global-shortcut:allow-unregister-all",
    "global-shortcut:allow-is-registered",
    "log:default",
    "log:allow-log",
    "os:default",
    "os:allow-os-type",
    "os:allow-arch",
    "os:allow-platform",
    "os:allow-version",
    "os:allow-hostname",
    "os:allow-locale",
    "store:default",
    "store:allow-get",
    "store:allow-set",
    "store:allow-delete",
    "store:allow-keys",
    "store:allow-values",
    "store:allow-entries",
    "store:allow-length",
    "store:allow-clear",
    "store:allow-save",
    "store:allow-load",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "notification:default",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify",
    "core:tray:default",
    "core:tray:allow-new",
    "core:tray:allow-set-tooltip",
    "core:menu:allow-set-text",
    "core:menu:allow-set-enabled",
    "core:menu:default",
    "core:window:allow-unminimize",
    "core:window:allow-set-badge-count",
    "core:window:allow-set-badge-label",
    "core:window:allow-set-overlay-icon",
    "core:window:allow-is-focused",
    "decorum:allow-show-snap-overlay"
  ]
}
