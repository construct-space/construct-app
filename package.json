{
  "name": "construct-space",
  "version": "1.3.1",
  "description": "Construct - AI-powered Operator",
  "author": "Flakerim Ismani",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run sidecars:build && cargo tauri dev",
    "dev:voice": "bun run sidecars:build && cargo tauri dev --features voice",
    "dev:frontend": "vite --config frontend/vite.config.ts",
    "build": "bun run sidecars:build && bun scripts/build-guard.ts",
    "build:mac": "bun run sidecars:build && bash -c 'source scripts/load-signing-key.sh && cargo tauri build --target aarch64-apple-darwin'",
    "build:mac-x64": "bun run sidecars:build && bash -c 'source scripts/load-signing-key.sh && cargo tauri build --target x86_64-apple-darwin'",
    "build:universal": "bun run sidecars:build && bash -c 'source scripts/load-signing-key.sh && cargo tauri build --target universal-apple-darwin'",
    "build:frontend": "vue-tsc --noEmit -p frontend/tsconfig.json && vite build --config frontend/vite.config.ts",
    "sidecars:build": "bun run brain:build",
    "brain:build": "bash scripts/build-brain.sh",
    "brain:test": "cd brain && go test ./...",
    "test": "vitest run --config frontend/vitest.config.ts",
    "test:watch": "vitest --config frontend/vitest.config.ts",
    "lint": "eslint --config frontend/eslint.config.js frontend/",
    "lint:fix": "eslint --config frontend/eslint.config.js frontend/ --fix",
    "typecheck": "vue-tsc --noEmit -p frontend/tsconfig.json",
    "check": "vue-tsc --noEmit -p frontend/tsconfig.json && eslint --config frontend/eslint.config.js frontend/",
    "release": "bash scripts/release.sh",
    "app": "bun run build && cp -r target/release/bundle/macos/Construct.app build/ && echo 'Ready: build/Construct.app' && open build/Construct.app"
  },
  "dependencies": {
    "@construct-space/sdk": "^2.0.4",
    "@construct-space/ui": "1.0.2",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-dialog": "2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-log": "^2.8.0",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-sql": "^2.4.0",
    "@tauri-apps/plugin-store": "^2.4.3",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@vueuse/core": "^14.3.0",
    "@vueuse/integrations": "^14.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "async-validator": "^4.2.5",
    "axios": "^1.16.1",
    "change-case": "^5.4.4",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.3",
    "dompurify": "^3.4.7",
    "drauu": "^1.0.0",
    "estree-walker": "3.0.3",
    "focus-trap": "^8.2.1",
    "fuse.js": "^7.3.0",
    "idb-keyval": "^6.2.4",
    "jwt-decode": "^4.0.0",
    "marked": "^18.0.4",
    "nprogress": "^0.2.0",
    "pinia": "^3.0.4",
    "qrcode": "^1.5.4",
    "sortablejs": "^1.15.7",
    "universal-cookie": "^8.1.2",
    "vue": "3.5.33",
    "vue-router": "5.0.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2.11.2",
    "@types/dompurify": "^3.2.0",
    "@types/marked": "^6.0.0",
    "@types/node": "^25.9.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.7",
    "@vue/server-renderer": "3.5.33",
    "@vue/test-utils": "^2.4.10",
    "agentkeepalive": "4.6.0",
    "eslint": "^10.4.1",
    "eslint-plugin-vue": "^10.9.1",
    "jsdom": "^29.1.1",
    "lucide-vue-next": "^1.0.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "8.0.14",
    "vitest": "^4.1.7",
    "vue-tsc": "^3.3.3"
  }
}